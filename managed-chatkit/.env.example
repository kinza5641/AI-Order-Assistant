# OpenAI API Key - Get from https://platform.openai.com/account/api-keys
# Must have ChatKit API access enabled
OPENAI_API_KEY=sk-proj-...

# ChatKit Workflow ID - Get from OpenAI Agent Builder
# Must start with 'wf_'
VITE_CHATKIT_WORKFLOW_ID=wf_...

# Optional: Override ChatKit API base URL (defaults to https://api.openai.com)
# CHATKIT_API_BASE=https://api.openai.com
# VITE_CHATKIT_API_BASE=https://api.openai.com

# Optional: Override API endpoint in frontend (for custom deployments)
# VITE_API_URL=http://127.0.0.1:8000
